  cam: {fileID: 638793293}
  lookDistance: 6
  shots:
  - name: 01_Kota_Tertidur
    points:
    - {fileID: 1416783305}
    - {fileID: 1341528}
    - {fileID: 1018528254}
    duration: 11
    fov: 55
    ease: 0.35
    handheld: 0.015
    reveal: {fileID: 0}
    captions:
    - text: 00:00. Seluruh kota sudah tertidur.
      start: 0.8
      duration: 4.2
    - text: Di sudut jalan ini, satu kantor kecil masih terjaga.
      start: 5.6
      duration: 4.8
  - name: 02_Kantor
    points:
    - {fileID: 1169201646}
    - {fileID: 223035187}
    - {fileID: 541297616}
    duration: 11
    fov: 48
    ease: 0.5
    handheld: 0.01
    reveal: {fileID: 0}
    captions:
    - text: Kantor IT Support. Satu jendela, satu komputer.
      start: 0.8
      duration: 4.6
    - text: Satu penjaga malam. Kamu.
      start: 6
      duration: 4.2
  - name: 03_Pengintai
    points:
    - {fileID: 203340875}
    - {fileID: 1754535155}
    duration: 8.5
    fov: 38
    ease: 0.2
    handheld: 0.008
    reveal: {fileID: 1637515200}
    captions:
    - text: Tapi bukan hanya kamu yang terjaga malam ini.
      start: 0.6
      duration: 3.6
    - text: Ia hanya berdiri dan menatap.
      start: 4.4
      duration: 3.8
  - name: 04_Masuk
    points:
    - {fileID: 1561199985}
    - {fileID: 1385156546}
    - {fileID: 1861305314}
    - {fileID: 763561367}
    duration: 15
    fov: 60
    ease: 0.55
    handheld: 0.012
    reveal: {fileID: 0}
    captions:
    - text: Setiap pesan yang masuk bisa jadi jebakan.
      start: 0.6
      duration: 4.2
    - text: Satu keputusan salah, dan ia melangkah lebih dekat.
      start: 5.4
      duration: 4.4
    - text: Bertahan sampai pukul 06:00.
      start: 10.6
      duration: 4
  titleSeconds: 3.5
  cutFadeSeconds: 0.45
  fadeOutSeconds: 0.9
  fadeGroup: {fileID: 949980546}
  titleGroup: {fileID: 1177180556}
  captionText: {fileID: 2027837484}
  letterboxTop: {fileID: 1042623195}
  letterboxBottom: {fileID: 2085327383}
  letterboxHeight: 130
  skipHint: {fileID: 2116826218}
  tutorialPanel: {fileID: 2145643225}
  tutorialTitle: {fileID: 826696824}
  tutorialBody: {fileID: 624205651}
  nextButton: {fileID: 1979116386}
  nextButtonLabel: {fileID: 1802680119}
  pages:
  - title: MISI MALAM INI
    body: 'Kamu staf IT shift malam. Dari pukul <b>00:00 sampai 06:00</b>, pantau inbox dan jaga akun perusahaan.


      Setiap pesan yang masuk: pilih <b>TERIMA</b> kalau asli, atau <b>BLOKIR</b> kalau penipuan.


      Periksa 4 hal sebelum memutuskan:


      - <b>Pengirim</b>: ejaan domain yang janggal (paypaI.com bukan paypal.com)

      - <b>Bahasa</b>: nada mendesak atau mengancam (''akun diblokir dalam 5 menit!'')

      - <b>Kode</b>: bank asli tidak pernah meminta OTP atau PIN

      - <b>Tautan</b>: arahkan kursor ke link untuk melihat tujuan sebenarnya'
  - title: BERTAHAN SAMPAI PAGI
    body: '<b>Threat Level</b> naik setiap kali kamu salah memutuskan. Makin tinggi, kantor makin gelap dan sosok di luar jendela makin dekat. Keputusan yang benar menurunkannya.


      <b>Menang</b>: bertahan sampai 06:00 dengan Threat di bawah 100%.

      <b>Kalah</b>: Threat mencapai 100% (System Compromised).


      <b>KONTROL</b>

      WASD jalan   |   Shift lari   |   Mouse menoleh

      E duduk di meja IT (E atau Esc untuk berdiri)

      V ganti kamera FPP/TPP   |   F senter

      Senter mati? Goyangkan mouse untuk menyalakannya lagi.'
  volume: {fileID: 1627937636}
  vignetteIntensity: 0.38
  grainIntensity: 0.3
  previewInEditor: 0
  previewShot: 0
  previewProgress: 0
